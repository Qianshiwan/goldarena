# ============================================================
#  生产环境变量示例 — 复制为 .env.prod 并填入真实值，部署前 source 或 export
#  用法: set -a && source .env.prod && set +a && docker compose -f docker-compose.prod.yml up -d --build
# ============================================================

# QQ 邮箱 SMTP 授权码（不是邮箱密码），用于发送注册/找回验证码
# 在 QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务后获取授权码
GOLDARENA_SMTP_PASS=your_qq_smtp_auth_code

# 覆盖默认管理员密码（admin 账户，优先于 config.prod.yaml 里的 seed_password）
ADMIN_PASSWORD=your_strong_admin_password
