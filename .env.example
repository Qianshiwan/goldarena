# =============================================
#  GoldArena Environment Variables
# =============================================

# Server
GATEWAY_PORT=8080
GIN_MODE=debug

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=goldarena
POSTGRES_PASSWORD=goldarena_dev
POSTGRES_DB=goldarena

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-use-256-bit-key
JWT_ACCESS_EXPIRE=24h
JWT_REFRESH_EXPIRE=168h

# Market Data (Twelve Data API)
TWELVE_DATA_API_KEY=your_api_key_here
TWELVE_DATA_BASE_URL=https://api.twelvedata.com

# WebSocket
WS_MAX_CONNECTIONS=10000
WS_WRITE_WAIT=10s
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s
